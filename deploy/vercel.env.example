# Copy the values into Vercel's Environment Variables rows.
# Do not commit a filled copy.

DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
JWT_SECRET=replace-with-openssl-rand-hex-32
PUBLIC_BASE_URL=https://www.your-domain.com
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ROUTE_COVER_BUCKET=route-covers
